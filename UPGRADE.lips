(out-of-scope
  "AI Assistant — Version 4"
  "Google / Apple OAuth — post-MVP"
  "WhatsApp / SMS notifications — Version 2"
  "Online payments / payment links — Version 2"
  "Native mobile apps — future"
  "White label / multi-tenant SaaS — future project (not this one)"
  "Inventory management — non-goal"
  "ERP / Accounting / POS — non-goal"
  "CAD / pattern-making — non-goal"
  "Public API / Webhooks for third parties — Version 5"
  "Multi-location / branch management — Version 6"
  "Analytics dashboards — Version 3"
  "Theme switcher — permanently excluded (ADR-026)"
  "Organization entity — permanently excluded (ADR-025)"
)

